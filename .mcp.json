{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "web-search": {
      "command": "node",
      "args": [
        "/path/to/extracted/web-search-mcp/dist/index.js"
      ]
    },
    "codebase-memory": {
      "command": "/usr/local/bin/codebase-memory-mcp",
      "args": [
        "server"
      ],
      "env": {}
    }
  }
}
